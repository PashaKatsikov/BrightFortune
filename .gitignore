# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing secrets - never commit these.
/android/key.properties
/android/keystore/
*.jks
*.keystore

# Relay-flow secrets - never commit real values.
android/app/google-services.json

# Forge recipe: holds the plaintext AppsFlyer key, messaging project
# number and config endpoint. forge.lock (identifying tuple only, no
# secrets) IS committed as the per-project audit trail.
tool/forge/recipe.json

# Symbol table produced by --split-debug-info.
build/debug_info/

# Local release build artifacts copied out for manual distribution.
/w_brightfortune_*.apk
/w_brightfortune_*.aab
